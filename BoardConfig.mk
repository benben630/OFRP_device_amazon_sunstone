DEVICE_PATH := device/amazon/sunstone

# Architecture
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv8-a
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_VARIANT := generic
TARGET_CPU_VARIANT_RUNTIME := cortex-a78
TARGET_2ND_ARCH := arm
TARGET_2ND_ARCH_VARIANT := armv8-a
TARGET_2ND_CPU_ABI := armeabi-v7a
TARGET_2ND_CPU_ABI2 := armeabi
TARGET_2ND_CPU_VARIANT := generic
TARGET_2ND_CPU_VARIANT_RUNTIME := cortex-a55
TARGET_USES_64_BIT_BINDER := true

TARGET_KERNEL_ARCH := arm64

# Platform
TARGET_BOARD_PLATFORM := mt8188
TARGET_BOOTLOADER_BOARD_NAME := mt8188
TARGET_NO_BOOTLOADER := true

# AVB Flags
BOARD_AVB_ENABLE := true
BOARD_AVB_RECOVERY_KEY_PATH := external/avb/test/data/testkey_rsa2048.pem
BOARD_AVB_RECOVERY_ALGORITHM := SHA256_RSA2048
BOARD_AVB_RECOVERY_ROLLBACK_INDEX := 2
BOARD_AVB_RECOVERY_ROLLBACK_INDEX_LOCATION := 0

# Kernel Config (Using extracted LineageOS kernel)
TARGET_PREBUILT_KERNEL := $(DEVICE_PATH)/prebuilts/Image.gz
BOARD_KERNEL_IMAGE_NAME := Image.gz
BOARD_BOOT_HEADER_VERSION := 3
BOARD_KERNEL_CMDLINE := bootopt=64S3,32N2,64N2
BOARD_KERNEL_CMDLINE += androidboot.selinux=permissive
BOARD_KERNEL_CMDLINE += enforcing=0
BOARD_KERNEL_CMDLINE += printk.devkmsg=on
BOARD_KERNEL_CMDLINE += panic=0
BOARD_KERNEL_CMDLINE += sysctl.kernel.panic_on_oops=0

BOARD_MKBOOTIMG_ARGS := \
    --header_version $(BOARD_BOOT_HEADER_VERSION) \
    --os_version 16.1.0 \
    --os_patch_level 2099-12

# Keymaster & Security Patch Levels
PLATFORM_VERSION := 16.1.0
PLATFORM_VERSION_LAST_STABLE := 16.1.0
PLATFORM_SECURITY_PATCH := 2099-12-31
VENDOR_SECURITY_PATCH := 2099-12-31
OF_DEFAULT_KEYMASTER_VERSION := 4.1

# Dynamic Partitions & Virtual A/B
BOARD_FLASH_BLOCK_SIZE := 131072
BOARD_BOOTIMAGE_PARTITION_SIZE := 33554432
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 50331648
BOARD_RECOVERYIMAGE_MAX_RAMDISK_SIZE := 30175232
BOARD_DTBOIMG_PARTITION_SIZE := 2097152
BOARD_CACHEIMAGE_PARTITION_SIZE := 566231040

BOARD_SUPER_PARTITION_SIZE := 4187594752
BOARD_SUPER_PARTITION_GROUPS := main
BOARD_MAIN_SIZE := 4185497600
BOARD_MAIN_PARTITION_LIST := system vendor

BOARD_BUILD_SYSTEM_ROOT_IMAGE := false
BOARD_USES_METADATA_PARTITION := true
TARGET_COPY_OUT_VENDOR := vendor
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := false
TARGET_USES_MKE2FS := true

OF_AB_DEVICE := 1
FOX_VIRTUAL_AB_DEVICE := 1

# Recovery Settings
TARGET_RECOVERY_PIXEL_FORMAT := "RGBX_8888"
TARGET_RECOVERY_DEVICE_DIRS := $(DEVICE_PATH)
TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/recovery.fstab

# Display & Touch Matrix Configuration (Fire Max 11 - 2000x1200)
TW_THEME := landscape_hdpi
OF_SCREEN_H := 1200
OF_SCREEN_W := 2000
OF_STATUS_H := 60
OF_STATUS_INDENT_LEFT := 48
OF_STATUS_INDENT_RIGHT := 48
OF_HIDE_NOTCH := 1
TW_ROTATION := 270
RECOVERY_TOUCHSCREEN_SWAP_XY := true
RECOVERY_TOUCHSCREEN_FLIP_X := true

# OrangeFox Project Versioning & Features
FOX_VERSION := R11.1_1
OF_MAINTAINER := "Ben"
OF_KEEP_FORCED_ENCRYPTION := 1
OF_ALLOW_DISABLE_NAVBAR := 0
OF_DISABLE_MIUI_SPECIFIC_FEATURES := 1
OF_USE_GREEN_LED := 0

# Storage Paths
TW_INTERNAL_STORAGE_PATH := "/data/media/0"
TW_INTERNAL_STORAGE_MOUNT_POINT := "data"
TW_EXTERNAL_STORAGE_PATH := "/external_sd"
TW_EXTERNAL_STORAGE_MOUNT_POINT := "external_sd"

# Encryption & Utilities
TW_INCLUDE_CRYPTO := true
TW_INCLUDE_CRYPTO_FBE := true
TW_USES_VENDOR_LIBS := true
TW_INCLUDE_RESETPROP := true
TWRP_INCLUDE_LOGCAT := true
TARGET_USES_LOGD := true

TW_INCLUDE_REPACKTOOLS := true
TW_INCLUDE_FASTBOOTD := true
TW_INCLUDE_LPTOOLS := true
TW_EXCLUDE_APEX := true
TW_EXCLUDE_DEFAULT_USB_INIT := true
TW_NO_FASTBOOT_BOOT := true
TW_NO_HAPTICS := true

ALLOW_MISSING_DEPENDENCIES := true
