# mount point       fstype  device                                device2              flags

/system_root        ext4    /dev/block/mapper/system                                   flags=display="System";logical;fsflags=ro
/vendor             ext4    /dev/block/mapper/vendor                                   flags=display="Vendor";logical;fsflags=ro

/data               ext4    /dev/block/by-name/userdata                                flags=display="Data";fileencryption=aes-256-xts:aes-256-cts:v2;keydirectory=/metadata/vold/metadata_encryption;wipeingui
/metadata           ext4    /dev/block/by-name/metadata                                flags=display="Metadata";backup=1;wipeingui
/cache              ext4    /dev/block/by-name/cache                                   flags=display="Cache";backup=1;wipeingui

/boot               emmc    /dev/block/by-name/boot                                    flags=display="Boot";backup=1;flashimg=1
/recovery           emmc    /dev/block/by-name/recovery                                flags=display="Recovery";backup=1;flashimg=1
/vendor_boot        emmc    /dev/block/by-name/vendor_boot                             flags=display="Vendor Boot";backup=1;flashimg=1
/dtbo               emmc    /dev/block/by-name/dtbo                                    flags=display="DTBO";backup=1;flashimg=1
/vbmeta             emmc    /dev/block/by-name/vbmeta                                  flags=display="VBMeta";backup=1;flashimg=1
/misc               emmc    /dev/block/by-name/misc                                    flags=display="Misc"
/boot_para          emmc    /dev/block/by-name/boot_para                               flags=display="Boot Para";backup=1

/nvcfg              ext4    /dev/block/by-name/nvcfg                                   flags=display="NVCFG";backup=1
/nvdata_persist     ext4    /dev/block/by-name/nvdata_persist                          flags=display="NVDATA Persist";backup=1

/lk                 emmc    /dev/block/by-name/lk_real                                 flags=display="Bootloader";backup=1;flashimg=1
/tee1               emmc    /dev/block/by-name/tee1_real                               flags=display="TEE1";backup=1;flashimg=1
/tee2               emmc    /dev/block/by-name/tee2_real                               flags=display="TEE2";backup=1;flashimg=1

/external_sd        vfat    /dev/block/mmcblk1p1                  /dev/block/mmcblk1   flags=display="MicroSD";storage;removable;wipeingui
/usb-otg            auto    /dev/block/sda1                       /dev/block/sda       flags=display="USB OTG";storage;removable;wipeingui
